{
  "name": "tour-pass",
  "version": "1.0.0",
  "description": "Tour Pass 是一个 C++17 城市自由行行程规划算法服务。MVP 使用长沙本地样例数据，将景点、餐厅、酒店和夜间活动点建模为 POI 图，结合 Dijkstra/A* 最短路、兴趣评分、时间窗调度、餐饮插入、POI 检索和 LLM/模板解释生成多日旅行计划。",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "container:smoke": "node scripts/container_smoke.js",
    "fetch:amap": "node scripts/fetch_amap_pois.js --config config/amap.changsha.json --out-dir output/amap-changsha",
    "build:amap-edges": "node scripts/build_commute_edges.js --pois output/amap-changsha/pois.json --out-dir output/amap-changsha --neighbors 6",
    "real:pipeline": "node scripts/run_real_data_pipeline.js",
    "real:retry-geo": "node scripts/retry_geo_edges.js",
    "real:route-pairs": "node scripts/fetch_real_route_pairs.js",
    "real:merge-edges": "node scripts/merge_route_edges.js",
    "real:promote-routes": "node scripts/promote_route_edges.js",
    "real:audit-routes": "node scripts/audit_route_quality.js",
    "quality:itinerary-smoke": "py -3 scripts/smoke_itinerary_quality.py",
    "real:smoke": "node scripts/real_data_smoke.js",
    "quality:algorithm": "node scripts/algorithm_quality_check.js",
    "load:test": "node scripts/load_test.js",
    "validate:data": "node scripts/validate_data.js --allow-transit-schedule-defaults --allow-disconnected --required-types attraction,restaurant,hotel",
    "validate:data:all": "node scripts/validate_data.js --all-cities",
    "test:validate-data-all": "node tests/test_validate_data_all_cities.js",
    "test:multi-agent": "node scripts/run_python_test.js tests/test_multi_agent.py -v",
    "editor:test": "npm --prefix web/editor run test",
    "editor:build": "npm --prefix web/editor run build",
    "test:amap-pipeline": "node tests/test_amap_pipeline.js",
    "test:import-real-pois": "node tests/test_import_real_pois.js",
    "test:gitattributes": "node tests/test_gitattributes_contract.js",
    "verify:ui": "node scripts/verify_ui.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4evour/Tour-Pass.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/4evour/Tour-Pass/issues"
  },
  "homepage": "https://github.com/4evour/Tour-Pass#readme",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
