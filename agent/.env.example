# TourPass Agent Service Configuration
# Copy this file to .env and fill in your values

# DeepSeek LLM (required)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# C++ Backend URL (Agent calls this for POI/hotel data and route optimization)
CPP_BACKEND_URL=http://127.0.0.1:8080

# Redis (optional, for multi-instance cache)
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=86400

# ChromaDB RAG (local directory for vector store)
CHROMA_PERSIST_DIR=data/chromadb
CHROMA_COLLECTION=city_guides

# Amap API (optional, supplementary only)
AMAP_API_KEY=

# Agent settings
MAX_LLM_CALLS=10
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# Server
AGENT_HOST=0.0.0.0
AGENT_PORT=8090

# QWeather (和风天气) API Key
# Register at https://dev.qweather.com/ to get your free key (1000 calls/day free tier)
# Find your API Host in Console > Settings (format: xxx.def.qweatherapi.com)
QWEATHER_KEY=
QWEATHER_API_HOST=
