# Standalone Trip Agent configuration
TRIP_AGENT_LLM_KEY=
TRIP_AGENT_BASE_URL=https://ztoken.zlux.top
TRIP_AGENT_MODEL=gpt-5.6-luna
TRIP_AGENT_WIRE_API=responses
TRIP_AGENT_REASONING_EFFORT=medium
TRIP_AGENT_FINAL_REASONING_EFFORT=high
TRIP_AGENT_MAX_OUTPUT_TOKENS=12000
TRIP_AGENT_LLM_TIMEOUT_SECONDS=480
AMAP_API_KEY=
QWEATHER_KEY=
TRIP_AGENT_CACHE=trip_agent/runtime-cache.sqlite
TRIP_AGENT_STORE=trip_agent/trips.sqlite
# Production uses Render PostgreSQL; local development can keep SQLite.
DATABASE_URL=
TRIP_AGENT_SECURE_COOKIES=false
TRIP_AGENT_TRUST_PROXY=false
TRIP_AGENT_IP_HASH_KEY=replace-with-a-long-random-secret
TRIP_AGENT_GUEST_DAILY_LIMIT=5
TRIP_AGENT_USER_DAILY_LIMIT=20
TRIP_AGENT_LOG=trip_agent/logs/planning.jsonl
AMAP_MIN_INTERVAL_SECONDS=0.2
TRIP_AGENT_MAX_STEPS=24
TRIP_AGENT_MAX_TOOLS=48
TRIP_AGENT_MAX_SUBMIT_ATTEMPTS=4
# Model-visible memory is compacted per request; values are clamped to safe ranges.
TRIP_AGENT_MEMORY_HISTORY_MESSAGES=4
TRIP_AGENT_MEMORY_MESSAGE_CHARS=800
TRIP_AGENT_MEMORY_PLAN_DAYS=7
TRIP_AGENT_MEMORY_ITEMS_PER_DAY=8
TRIP_AGENT_MEMORY_EVIDENCE_PLACES=24
TRIP_AGENT_MEMORY_EVIDENCE_ROUTES=24
TRIP_AGENT_REVIEWER_ENABLED=true
TRIP_AGENT_REVIEWER_SHADOW=true
TRIP_AGENT_RUN_TIMEOUT_SECONDS=600
